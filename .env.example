# Configuración de Firebase para PCEP Trainer
# Obtén estos valores desde la Consola de Firebase > Configuración del proyecto > General > Tus apps > Web app

VITE_FIREBASE_API_KEY=AIzaSyTuClaveApiKeyDeFirebaseAqui
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto-pcep.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-pcep
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto-pcep.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
